#!/bin/bash
set -e

notify() {
    notify-send -a "HorizonOS" -i system-software-update -u critical "$1" "$2" || true
}

send_notification() {
    local title="$1"
    local message="$2"

    # Called from a user service (e.g. horizon-setup-user): notify our own session
    if [ "$(id -u)" -ne 0 ]; then
        notify "$title" "$message"
        return
    fi

    # Called as root: notify every user with a graphical session
    local session type uid
    local -A notified=()
    for session in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
        type=$(loginctl show-session "$session" -p Type --value)
        [[ "$type" == "wayland" || "$type" == "x11" ]] || continue
        uid=$(loginctl show-session "$session" -p User --value)
        [[ "$uid" -ne 0 && -z "${notified[$uid]:-}" ]] || continue
        notified[$uid]=1
        sudo -u "#$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            notify-send -a "HorizonOS" -i system-software-update -u critical "$title" "$message" || true
    done
}

if [[ "$#" -ge 2 ]]; then
    send_notification "$1" "$2"
fi
