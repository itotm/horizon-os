#!/bin/bash
set -oue pipefail

logger "Flatpak configuration"

# only Fedora/ISO flatpaks: a re-run must not remove apps installed from flathub.
# By full ref: a bare name installed in two branches (e.g. f44 and f45) makes
# flatpak ask which one to remove, and the uninstall aborts
flatpak list --app --columns=ref,origin | while read -r app origin; do
    if [ -n "$app" ] && [ "$origin" != "flathub" ]; then
        flatpak uninstall -y --delete-data "$app" 2>/dev/null || true
    fi
done

flatpak list --runtime --columns=application | while read -r runtime; do
    if [ -n "$runtime" ]; then
        flatpak mask --remove "$runtime" 2>/dev/null || true
    fi
done

flatpak list --runtime --columns=ref,origin | while read -r runtime origin; do
    if [ -n "$runtime" ] && [ "$origin" != "flathub" ]; then
        flatpak uninstall -y --delete-data "$runtime" 2>/dev/null || true
    fi
done

for remote in fedora fedora-testing; do
    if flatpak remotes | grep -q "^$remote"; then
        flatpak remote-delete "$remote" 2>/dev/null || true
    fi
done

flatpak uninstall -y --unused 2>/dev/null || true

flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
flatpak remote-modify --enable flathub

# download it and cs locales (spell-check dictionaries) besides the system language
flatpak config --set extra-languages "it;cs"

logger "Flatpak configuration completed"
