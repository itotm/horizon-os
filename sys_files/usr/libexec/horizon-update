#!/bin/bash
set -oue pipefail

logger "Starting automatic system update"

if ! /usr/libexec/horizon-check-version /etc/horizon-version-actual; then
    logger "System update cancelled: first run post-install procedures"
    exit 0
fi

export LOG_FILE="/var/log/horizon-update.log"

BOOTC_STATUS=$(/usr/libexec/horizon-update-bootc)

if [ "$BOOTC_STATUS" = true ]; then
    /usr/libexec/horizon-notify "Update Completed" "Reboot to apply bootc updates."
elif [ "$BOOTC_STATUS" = failed ]; then
    /usr/libexec/horizon-notify "Update Failed" "bootc upgrade failed. Details: journalctl -t horizon-update-bootc"
    logger -p user.err "System update: failed"
    # leave the unit in failed state too, so systemctl --failed shows it
    exit 1
fi

logger "System update: completed"
exit 0
