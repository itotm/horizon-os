#!/bin/bash
set -oue pipefail

logger "HorizonOS installing flatpaks"

flatpak override --user --filesystem=xdg-config/gtk-3.0:ro
flatpak override --user --filesystem=xdg-config/gtk-4.0:ro

# Thunderbird: a mailto: link clicked in Firefox starts a second instance with
# Firefox's environment. Firefox runs with HOME=/var/home/<user> (the resolved
# path) while the session uses /home/<user>, and Thunderbird derives its
# single-instance DBus name from the profile path, so the second instance does
# not find the running one and fails with "already running but not responding".
# Pin HOME to the passwd value and drop Firefox's remoting name.
flatpak override --user --env=HOME="$(getent passwd "$(id -un)" | cut -d: -f6)" org.mozilla.thunderbird
flatpak override --user --unset-env=MOZ_APP_REMOTINGNAME org.mozilla.thunderbird

FLATPAK_PACKAGES=(
    app.comaps.comaps
    com.calibre_ebook.calibre
    com.github.PintaProject.Pinta
    com.github.tchx84.Flatseal
    com.usebottles.bottles
    fr.handbrake.ghb
    hu.irl.cameractrls
    io.github.flattool.Warehouse
    io.github.plrigaux.sysd-manager
    io.github.DenysMb.Kontainer
    io.qt.qdbusviewer
    it.mijorus.gearlever
    net.hovancik.Stretchly
    net.lutris.Lutris
    net.mediaarea.MediaInfo
    no.mifi.losslesscut
    org.audacityteam.Audacity
    org.avidemux.Avidemux
    org.bunkus.mkvtoolnix-gui
    org.chromium.Chromium
    org.gnome.meld
    org.gimp.GIMP
    org.gtk.Gtk3theme.Breeze
    org.inkscape.Inkscape
    org.kde.krdc
    org.libreoffice.LibreOffice
    org.mozilla.thunderbird
    org.qbittorrent.qBittorrent
    org.remmina.Remmina
)

FAILED=()
for package in "${FLATPAK_PACKAGES[@]}"; do
    if ! flatpak list --columns=application | grep -Fxq "$package"; then
        logger "Installing $package"
        flatpak install -y --noninteractive flathub "$package" || FAILED+=("$package")
    fi
done

if [ ${#FAILED[@]} -gt 0 ]; then
    logger "HorizonOS flatpak installation failed: ${FAILED[*]}"
    /usr/libexec/horizon-notify "Flatpak installation" "Not installed: ${FAILED[*]}"
fi

logger "HorizonOS flatpak installation completed"
