#!/usr/bin/bash
set -euo pipefail

logger "Services configuration"

SERVICES=(
    "backrest.service"
    "horizon-update.timer"
    "cockpit.socket"
    "podman.socket"
    "sshd"
)

# Hydrascale is only in the image when it is built with ENABLE_EXTENDED, and
# then it runs every tailnet in place of the system tailscaled
if [ -x /usr/bin/hydrascale ]; then
    SERVICES+=("hydrascale.service")
else
    SERVICES+=("tailscaled")
fi

for service in "${SERVICES[@]}"; do
    systemctl enable "${service}" 2>/dev/null || true
done

echo "Defaults pwfeedback" > /etc/sudoers.d/horizon
chmod 0440 /etc/sudoers.d/horizon
visudo --check --file /etc/sudoers.d/horizon || rm -f /etc/sudoers.d/horizon

logger "Services configuration completed"
