#!/bin/bash
set -oue pipefail

# libvirt is only in the image when it is built with ENABLE_VIRTTOOLS
if ! rpm -q --quiet libvirt; then
    exit 0
fi

logger "Configuring libvirt"

USER_NAME=$(awk -F: '$3 >= 1000 && $1 !~ /^systemd-/ {print $1; exit}' /etc/passwd)

# libvirt's polkit rule lets the libvirt group manage qemu:///system without a
# password, so virt-manager no longer asks for one
usermod -aG libvirt "$USER_NAME"

restorecon -Rv /var/lib/libvirt
restorecon -Rv /var/log/libvirt

logger "libvirt configured"
