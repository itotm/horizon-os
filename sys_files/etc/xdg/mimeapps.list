# HorizonOS default applications.
#
# Read by KDE (KService) and by GLib/GIO (xdg-desktop-portal, GTK and Flatpak
# apps) before /usr/share/applications/{kde-,}mimeapps.list; a user's own
# ~/.config/mimeapps.list still wins. Without these entries every type that the
# shipped lists do not cover goes to whichever handler sorts first: Flatpak ids
# (com.*, fr.*, net.*) beat org.kde.* and vlc, so calibre takes ODT/DOCX/comics,
# Chromium takes XML, HandBrake/MediaInfo/Audacity take audio, GIMP/Pinta take
# images.
#
# Only canonical MIME names are listed: aliases (application/x-cbz, text/xml,
# application/x-font-ttf, ...) are resolved by the MIME database. Check a name
# with: kmimetypefinder6 <file>  or  gio info -a standard::content-type <file>

[Default Applications]

# Web
application/hta=org.mozilla.firefox.desktop;
application/x-mozilla-bookmarks=org.mozilla.firefox.desktop;
application/xhtml+xml=org.mozilla.firefox.desktop;
text/html=org.mozilla.firefox.desktop;
x-scheme-handler/http=org.mozilla.firefox.desktop;
x-scheme-handler/https=org.mozilla.firefox.desktop;

# Mail, calendar, contacts (Thunderbird Flatpak)
message/rfc822=org.mozilla.thunderbird.desktop;
text/calendar=org.mozilla.thunderbird.desktop;
text/vcard=org.mozilla.thunderbird.desktop;
x-scheme-handler/mailto=org.mozilla.thunderbird.desktop;
x-scheme-handler/mid=org.mozilla.thunderbird.desktop;
x-scheme-handler/webcal=org.mozilla.thunderbird.desktop;
x-scheme-handler/webcals=org.mozilla.thunderbird.desktop;

# eBooks (calibre viewer, not the library)
